{
  "info": {
    "name": "AutoLoc - Vehicules CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Five CRUD checks required for the Vehicule REST controller. Run in order."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8085/api" },
    { "key": "vehiculeId", "value": "" }
  ],
  "item": [
    {
      "name": "1 - create vehicule",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"immatriculation\": \"TEST-001\",\n  \"marque\": \"Toyota\",\n  \"modele\": \"Yaris\",\n  \"categorie\": \"CITADINE\",\n  \"tarifJournalier\": 120.50,\n  \"statut\": \"DISPONIBLE\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/vehicules", "host": ["{{baseUrl}}"], "path": ["vehicules"] }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status is 200 or 201', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
        "const body = pm.response.json();",
        "pm.expect(body.idVehicule).to.exist;",
        "pm.collectionVariables.set('vehiculeId', body.idVehicule);"
      ] } }]
    },
    {
      "name": "2 - findAll vehicules",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/vehicules", "host": ["{{baseUrl}}"], "path": ["vehicules"] }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
        "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"
      ] } }]
    },
    {
      "name": "3 - findById vehicule",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/vehicules/{{vehiculeId}}", "host": ["{{baseUrl}}"], "path": ["vehicules", "{{vehiculeId}}"] }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
        "pm.test('Returned ID matches created ID', function () { pm.expect(pm.response.json().idVehicule).to.eql(Number(pm.collectionVariables.get('vehiculeId'))); });"
      ] } }]
    },
    {
      "name": "4 - update vehicule",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"immatriculation\": \"TEST-001\",\n  \"marque\": \"Toyota\",\n  \"modele\": \"Yaris Updated\",\n  \"categorie\": \"CITADINE\",\n  \"tarifJournalier\": 135.00,\n  \"statut\": \"LOUE\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/vehicules/{{vehiculeId}}", "host": ["{{baseUrl}}"], "path": ["vehicules", "{{vehiculeId}}"] }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
        "pm.test('Model was updated', function () { pm.expect(pm.response.json().modele).to.eql('Yaris Updated'); });"
      ] } }]
    },
    {
      "name": "5 - deleteById vehicule",
      "request": {
        "method": "DELETE",
        "url": { "raw": "{{baseUrl}}/vehicules/{{vehiculeId}}", "host": ["{{baseUrl}}"], "path": ["vehicules", "{{vehiculeId}}"] }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('Status is successful', function () { pm.expect(pm.response.code).to.be.oneOf([200, 204]); });"
      ] } }]
    }
  ]
}
